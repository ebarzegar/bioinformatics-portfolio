import numpy
import matplotlib.pyplot as plt


def delta(x, y):
    if x == y:
        return 0
    else:
        return 1


def m_point(seq1, seq2, i, j):
    x, y = seq1[i], seq2[j]
    return delta(x, y)


def make_matrix(seq1, seq2):
    n = len(seq1)
    m = len(seq2)

    ret_list = []
    for i in range(n):
        tmp_list = []
        for j in range(m):
            tmp_list.append(m_point(seq1, seq2, i, j))
        ret_list.append(tmp_list)

    return ret_list


