from pprint import pprint

class DNA:

    def __init__(self, name, accession_number, sequence, official_symbol, coding):
        self.name = name
        self.acc_num = accession_number
        self.os = official_symbol
        self.sequence = sequence

        if not self.__check_dna():
            raise Exception("Wrong DNA")

        if isinstance(coding, dict):
            self.coding = coding
        else:
            raise Exception("Coding should be dictionary")

    def __check_dna(self):
        dna = self.sequence.replace("A", "")
        dna = dna.replace("T", "")
        dna = dna.replace("C", "")
        dna = dna.replace("G", "")
        if dna != "":
            return False
        else:
            return True

    def show_properties(self):
        print_str = "-----------------------------Properties-------------------------------\n"
        print_str += "Name: " + self.name + "\n"
        print_str += "Accession Number: " + self.acc_num + "\n"
        print_str += "Official Symbol: " + self.os + "\n"
        print_str += "Sequence: " + self.sequence
        print_str += "\n----------------------------------------------------------------------"
        print(print_str)

    def show_codings(self):
        print("-----------------------------Codings----------------------------------")
        for key, value in self.coding.items():
            print(key, "->", value)
        print("----------------------------------------------------------------------")


